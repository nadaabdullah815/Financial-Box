@model FinancialBox.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "الرئيسية";
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "صباح الخير" : hour < 17 ? "مساءً سعيدًا" : "مساء الخير";
    var net = Model.MonthIncome - Model.MonthExpense;
}

<div class="container-fluid py-4">

    <!-- الترحيب -->
    <div class="welcome-banner mb-4 p-4">
        <h3 class="fw-bold text-white mb-1">@greeting، @Model.FullName 👋</h3>
        <p class="text-white-50 mb-0">هذه نظرة سريعة على وضعك المالي اليوم</p>
    </div>

    <!-- KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm kpi-card">
                <div class="card-body d-flex align-items-center">
                    <div class="kpi-icon bg-success-subtle text-success"><i class="bi bi-wallet2"></i></div>
                    <div class="ms-3">
                        <div class="small text-muted">عدد الصناديق</div>
                        <div class="fs-4 fw-bold">@Model.Boxes.Count</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm kpi-card">
                <div class="card-body d-flex align-items-center">
                    <div class="kpi-icon bg-success-subtle text-success"><i class="bi bi-graph-up-arrow"></i></div>
                    <div class="ms-3">
                        <div class="small text-muted">إيرادات هذا الشهر</div>
                        <div class="fs-5 fw-bold text-success">@Model.MonthIncome.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm kpi-card">
                <div class="card-body d-flex align-items-center">
                    <div class="kpi-icon bg-danger-subtle text-danger"><i class="bi bi-graph-down-arrow"></i></div>
                    <div class="ms-3">
                        <div class="small text-muted">مصاريف هذا الشهر</div>
                        <div class="fs-5 fw-bold text-danger">@Model.MonthExpense.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm kpi-card">
                <div class="card-body d-flex align-items-center">
                    <div class="kpi-icon bg-primary-subtle text-primary"><i class="bi bi-calculator"></i></div>
                    <div class="ms-3">
                        <div class="small text-muted">صافي الشهر</div>
                        <div class="fs-5 fw-bold @(net >= 0 ? "text-success" : "text-danger")">@net.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- بطاقات التنقل -->
        <div class="col-lg-8">
            <h6 class="fw-bold mb-3"><i class="bi bi-grid-fill me-2"></i>الانتقال السريع</h6>
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4">
                    <a asp-controller="Box" asp-action="Index" class="nav-card income-grad">
                        <i class="bi bi-wallet2"></i><span>الصناديق</span>
                    </a>
                </div>
                <div class="col-6 col-md-4">
                    <a asp-controller="Category" asp-action="Index" class="nav-card cat-grad">
                        <i class="bi bi-tags-fill"></i><span>التصنيفات</span>
                    </a>
                </div>
                <div class="col-6 col-md-4">
                    <a asp-controller="Transfer" asp-action="Index" class="nav-card transfer-grad">
                        <i class="bi bi-arrow-left-right"></i><span>الحوالات</span>
                    </a>
                </div>
                <div class="col-6 col-md-4">
                    <a asp-controller="Report" asp-action="Index" class="nav-card report-grad">
                        <i class="bi bi-bar-chart-fill"></i><span>التقارير</span>
                    </a>
                </div>
                <div class="col-6 col-md-4">
                    <a asp-controller="Transfer" asp-action="Create" class="nav-card expense-grad">
                        <i class="bi bi-send-check-fill"></i><span>حوالة جديدة</span>
                    </a>
                </div>
                <div class="col-6 col-md-4">
                    <a asp-controller="Account" asp-action="Logout" class="nav-card logout-grad" onclick="event.preventDefault(); document.getElementById('logoutForm').submit();">
                        <i class="bi bi-box-arrow-right"></i><span>تسجيل الخروج</span>
                    </a>
                </div>
            </div>

            @if (Model.DebtBox != null && Model.DebtBox.TargetAmount.HasValue && Model.DebtBox.TargetAmount > 0)
            {
                var progress = Math.Min(100, (double)(Model.DebtBox.Balance / Model.DebtBox.TargetAmount.Value) * 100);
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="fw-bold mb-2"><i class="bi bi-clipboard2-check-fill me-2"></i>تقدّم تسوية الديون</h6>
                        <div class="progress mb-2" style="height: 10px;">
                            <div class="progress-bar bg-info" style="width:@progress.ToString("0")%"></div>
                        </div>
                        <small class="text-muted">@Model.DebtBox.Balance.ToString("N2") من أصل @Model.DebtBox.TargetAmount.Value.ToString("N2")</small>
                    </div>
                </div>
            }
        </div>

        <!-- آخر العمليات -->
        <div class="col-lg-4">
            <h6 class="fw-bold mb-3"><i class="bi bi-clock-history me-2"></i>آخر العمليات</h6>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    @if (!Model.RecentTransactions.Any())
                    {
                        <p class="text-center text-muted py-4 mb-0 small">لا توجد عمليات بعد</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var t in Model.RecentTransactions)
                            {
                                var isIncome = t.Category.Type == FinancialBox.Models.Enum.CategoryType.Income;
                                <li class="list-group-item d-flex justify-content-between align-items-center px-3">
                                    <div>
                                        <div class="small fw-semibold">@t.Category.Name</div>
                                        <div class="small text-muted">@t.Box.Name · @t.Date.ToString("yyyy-MM-dd")</div>
                                    </div>
                                    <span class="fw-bold @(isIncome ? "text-success" : "text-danger")">
                                        @(isIncome ? "+" : "-")@t.Amount.ToString("N2")
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" class="d-none"></form>

<style>
    .welcome-banner {
        background: linear-gradient(120deg, #146c43, #0f5132);
        border-radius: 18px;
    }
    .kpi-card { border-radius: 14px; }
    .kpi-icon {
        width: 50px; height: 50px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center; font-size: 1.3rem;
    }
    .nav-card {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: .5rem; height: 110px; border-radius: 16px; color: #fff; text-decoration: none;
        font-weight: 700; transition: .2s ease; box-shadow: 0 4px 14px rgba(0,0,0,.08);
    }
    .nav-card i { font-size: 1.7rem; }
    .nav-card:hover { transform: translateY(-4px); color: #fff; }
    .income-grad   { background: linear-gradient(135deg, #146c43, #0f5132); }
    .cat-grad      { background: linear-gradient(135deg, #fd7e14, #c2590a); }
    .transfer-grad { background: linear-gradient(135deg, #0d6efd, #0a4fb0); }
    .report-grad   { background: linear-gradient(135deg, #6f42c1, #4b2a86); }
    .expense-grad  { background: linear-gradient(135deg, #20c997, #138a6a); }
    .logout-grad   { background: linear-gradient(135deg, #6c757d, #495057); }
</style>