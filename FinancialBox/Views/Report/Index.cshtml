@model FinancialBox.ViewModels.ReportViewModel
@{
    ViewData["Title"] = "التقارير";
    var netTotal = Model.TotalIncome - Model.TotalExpense;
}

<div class="container-fluid py-4" id="reportPage">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 no-print">
        <div>
            <h3 class="fw-bold text-success mb-1"><i class="bi bi-bar-chart-fill me-2"></i>التقارير المالية</h3>
            <p class="text-muted mb-0">نظرة شاملة على إيراداتك ومصاريفك وأرصدة صناديقك</p>
        </div>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> طباعة التقرير
        </button>
    </div>

    <!-- فلتر الفترة -->
    <div class="card border-0 shadow-sm mb-4 no-print">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-auto">
                    <label class="form-label fw-semibold small mb-1">من تاريخ</label>
                    <input type="date" name="from" class="form-control" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-auto">
                    <label class="form-label fw-semibold small mb-1">إلى تاريخ</label>
                    <input type="date" name="to" class="form-control" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-funnel-fill me-1"></i> تطبيق
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ملخص سريع -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm summary-mini income-mini">
                <div class="card-body">
                    <div class="small text-muted">إجمالي الإيرادات</div>
                    <div class="fs-4 fw-bold text-success">@Model.TotalIncome.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm summary-mini expense-mini">
                <div class="card-body">
                    <div class="small text-muted">إجمالي المصاريف</div>
                    <div class="fs-4 fw-bold text-danger">@Model.TotalExpense.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm summary-mini">
                <div class="card-body">
                    <div class="small text-muted">صافي الفترة</div>
                    <div class="fs-4 fw-bold @(netTotal >= 0 ? "text-success" : "text-danger")">@netTotal.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm summary-mini">
                <div class="card-body">
                    <div class="small text-muted">عدد الصناديق</div>
                    <div class="fs-4 fw-bold">@Model.Boxes.Count</div>
                </div>
            </div>
        </div>
    </div>

    <!-- علامات التبويب -->
    <ul class="nav nav-pills mb-4 flex-wrap gap-2 no-print" id="reportTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-income" type="button">
                <i class="bi bi-graph-up-arrow me-1"></i> الإيرادات حسب الفترة
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-expense" type="button">
                <i class="bi bi-graph-down-arrow me-1"></i> المصاريف حسب الفترة
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-balances" type="button">
                <i class="bi bi-wallet2 me-1"></i> أرصدة الصناديق
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-income-cat" type="button">
                <i class="bi bi-pie-chart-fill me-1"></i> الإيرادات حسب التصنيف
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-expense-cat" type="button">
                <i class="bi bi-pie-chart me-1"></i> المصاريف حسب التصنيف
            </button>
        </li>
    </ul>

    <div class="tab-content">

        <!-- 1. الإيرادات حسب الفترة -->
        <div class="tab-pane fade show active" id="tab-income">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    @if (!Model.IncomeTransactions.Any())
                    {
                        <p class="text-center text-muted py-5 mb-0">لا توجد إيرادات مسجلة خلال هذه الفترة</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr><th>التاريخ</th><th>الصندوق</th><th>التصنيف</th><th>البيان</th><th>المبلغ</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.IncomeTransactions)
                                    {
                                        <tr>
                                            <td>@t.Date.ToString("yyyy-MM-dd")</td>
                                            <td>@t.Box.Name</td>
                                            <td><span class="badge bg-success-subtle text-success">@t.Category.Name</span></td>
                                            <td class="text-muted">@(string.IsNullOrWhiteSpace(t.Description) ? "—" : t.Description)</td>
                                            <td class="fw-bold text-success">+@t.Amount.ToString("N2") @t.Box.Currency</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr><th colspan="4" class="text-end">الإجمالي</th><th class="text-success">@Model.TotalIncome.ToString("N2")</th></tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 2. المصاريف حسب الفترة -->
        <div class="tab-pane fade" id="tab-expense">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    @if (!Model.ExpenseTransactions.Any())
                    {
                        <p class="text-center text-muted py-5 mb-0">لا توجد مصاريف مسجلة خلال هذه الفترة</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr><th>التاريخ</th><th>الصندوق</th><th>التصنيف</th><th>البيان</th><th>المبلغ</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.ExpenseTransactions)
                                    {
                                        <tr>
                                            <td>@t.Date.ToString("yyyy-MM-dd")</td>
                                            <td>@t.Box.Name</td>
                                            <td><span class="badge bg-danger-subtle text-danger">@t.Category.Name</span></td>
                                            <td class="text-muted">@(string.IsNullOrWhiteSpace(t.Description) ? "—" : t.Description)</td>
                                            <td class="fw-bold text-danger">-@t.Amount.ToString("N2") @t.Box.Currency</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr><th colspan="4" class="text-end">الإجمالي</th><th class="text-danger">@Model.TotalExpense.ToString("N2")</th></tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 3. أرصدة الصناديق -->
        <div class="tab-pane fade" id="tab-balances">
            <div class="row g-3">
                @foreach (var box in Model.Boxes)
                {
                    <div class="col-md-4 col-lg-3">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <span class="badge bg-light text-dark border mb-2">@box.Currency</span>
                                <h6 class="fw-bold mb-1">@box.Name</h6>
                                <div class="fs-5 fw-bold text-success">@box.Balance.ToString("N2")</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- 4. الإيرادات حسب التصنيف -->
        <div class="tab-pane fade" id="tab-income-cat">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    @if (!Model.IncomeByCategory.Any())
                    {
                        <p class="text-center text-muted py-4 mb-0">لا توجد بيانات لعرضها</p>
                    }
                    else
                    {
                        @foreach (var c in Model.IncomeByCategory)
                        {
                            var pct = Model.TotalIncome > 0 ? (c.Total / Model.TotalIncome) * 100 : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-semibold">@c.CategoryName <small class="text-muted">(@c.Count عملية)</small></span>
                                    <span class="fw-bold text-success">@c.Total.ToString("N2")</span>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar bg-success" style="width:@pct.ToString("0")%"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- 5. المصاريف حسب التصنيف -->
        <div class="tab-pane fade" id="tab-expense-cat">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    @if (!Model.ExpenseByCategory.Any())
                    {
                        <p class="text-center text-muted py-4 mb-0">لا توجد بيانات لعرضها</p>
                    }
                    else
                    {
                        @foreach (var c in Model.ExpenseByCategory)
                        {
                            var pct = Model.TotalExpense > 0 ? (c.Total / Model.TotalExpense) * 100 : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-semibold">@c.CategoryName <small class="text-muted">(@c.Count عملية)</small></span>
                                    <span class="fw-bold text-danger">@c.Total.ToString("N2")</span>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar bg-danger" style="width:@pct.ToString("0")%"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .summary-mini { border-radius: 14px; border-top: 4px solid #146c43 !important; }
    .income-mini { border-top-color: #146c43 !important; }
    .expense-mini { border-top-color: #dc3545 !important; }
    #reportTabs .nav-link { color: #495057; font-weight: 600; border-radius: 30px; }
    #reportTabs .nav-link.active { background-color: #146c43; color: #fff; }

    @@media print {
        .no-print { display: none !important; }
        .tab-pane { display: block !important; opacity: 1 !important; margin-bottom: 2rem; }
    }
</style>