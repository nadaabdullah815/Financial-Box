@model FinancialBox.ViewModels.TransferViewModel
@using System.Globalization
@{
    ViewData["Title"] = "حوالة جديدة";
    var boxes = Model.Boxes ?? new List<FinancialBox.Models.Box>();
}

<div class="container py-4" style="max-width: 920px;">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-success mb-1"><i class="bi bi-arrow-left-right me-2"></i>حوالة بين الصناديق</h3>
            <p class="text-muted mb-0">انقل الأموال من صندوق إلى آخر بنفس العملة</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-clock-history me-1"></i> سجل الحوالات
        </a>
    </div>

    @if (!boxes.Any(b => b.Balance > 0))
    {
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
            <div>لا يوجد أي صندوق يحتوي على رصيد حاليًا. سجّل إيرادًا على أحد الصناديق أولًا، ثم عد لإجراء الحوالة.</div>
        </div>
    }

    <form asp-action="Create" method="post" id="transferForm">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- الخطوة 1: المحوَّل منه -->
        <div class="card border-0 shadow-sm mb-3 step-card">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><span class="step-badge">1</span> الصندوق المحوَّل منه</h6>
                <div class="row g-3">
                    @foreach (var box in boxes)
                    {
                        var (icon, color) = GetBoxStyle(box.Name);
                        <div class="col-6 col-md-4">
                            <input type="radio" class="btn-check" name="FromBoxId" id="from_@box.Id" value="@box.Id"
                                   data-balance="@box.Balance.ToString(CultureInfo.InvariantCulture)"
                                   data-currency="@box.Currency" data-name="@box.Name"
                                   checked="@(Model.FromBoxId == box.Id)" disabled="@(box.Balance <= 0)" />
                            <label class="box-option card h-100 text-center p-3" for="from_@box.Id">
                                <div class="option-icon @color mx-auto mb-2"><i class="bi @icon fs-4"></i></div>
                                <div class="fw-bold small">@box.Name</div>
                                <div class="text-success fw-bold">@box.Balance.ToString("N2")</div>
                                <span class="badge bg-light text-dark border mt-1">@box.Currency</span>
                            </label>
                        </div>
                    }
                </div>
                <span asp-validation-for="FromBoxId" class="text-danger small"></span>
            </div>
        </div>

        <!-- زر العكس -->
        <div class="text-center my-n2 position-relative" style="z-index: 2;">
            <button type="button" id="swapBtn" class="btn btn-success rounded-circle shadow swap-btn" title="عكس اتجاه الحوالة">
                <i class="bi bi-arrow-down-up"></i>
            </button>
        </div>

        <!-- الخطوة 2: المحوَّل إليه -->
        <div class="card border-0 shadow-sm mb-3 step-card">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-1"><span class="step-badge">2</span> الصندوق المحوَّل إليه</h6>
                <p class="text-muted small mb-3" id="toHint">اختر أولًا الصندوق المحوَّل منه، وستظهر لك الصناديق المتوافقة معه فقط.</p>
                <div class="row g-3">
                    @foreach (var box in boxes)
                    {
                        var (icon, color) = GetBoxStyle(box.Name);
                        <div class="col-6 col-md-4">
                            <input type="radio" class="btn-check" name="ToBoxId" id="to_@box.Id" value="@box.Id"
                                   data-balance="@box.Balance.ToString(CultureInfo.InvariantCulture)"
                                   data-currency="@box.Currency" data-name="@box.Name"
                                   checked="@(Model.ToBoxId == box.Id)" />
                            <label class="box-option card h-100 text-center p-3" for="to_@box.Id">
                                <div class="option-icon @color mx-auto mb-2"><i class="bi @icon fs-4"></i></div>
                                <div class="fw-bold small">@box.Name</div>
                                <div class="text-muted small">@box.Balance.ToString("N2")</div>
                                <span class="badge bg-light text-dark border mt-1">@box.Currency</span>
                            </label>
                        </div>
                    }
                </div>
                <span asp-validation-for="ToBoxId" class="text-danger small"></span>
            </div>
        </div>

        <!-- الخطوة 3: المبلغ والتفاصيل -->
        <div class="card border-0 shadow-sm mb-3 step-card">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><span class="step-badge">3</span> المبلغ والتفاصيل</h6>

                <label asp-for="Amount" class="form-label fw-semibold">المبلغ</label>
                <div class="input-group input-group-lg mb-2">
                    <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control"
                           placeholder="0.00"
                           value="@(Model.Amount > 0 ? Model.Amount.ToString(CultureInfo.InvariantCulture) : "")" />
                    <span class="input-group-text fw-bold" id="currencyLabel">—</span>
                </div>
                <span asp-validation-for="Amount" class="text-danger small"></span>

                <div class="d-flex gap-2 flex-wrap mb-3 mt-2">
                    <button type="button" class="btn btn-sm btn-outline-success quick-pct" data-pct="25">25%</button>
                    <button type="button" class="btn btn-sm btn-outline-success quick-pct" data-pct="50">50%</button>
                    <button type="button" class="btn btn-sm btn-outline-success quick-pct" data-pct="75">75%</button>
                    <button type="button" class="btn btn-sm btn-outline-success quick-pct" data-pct="100">كامل الرصيد</button>
                </div>

                <div class="row g-3">
                    <div class="col-md-5">
                        <label asp-for="Date" class="form-label fw-semibold">تاريخ الحوالة</label>
                        <input asp-for="Date" type="date" class="form-control"
                               value="@Model.Date.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="Description" class="form-label fw-semibold">الوصف <span class="text-muted fw-normal">(اختياري)</span></label>
                        <input asp-for="Description" class="form-control" placeholder="مثال: سحب نقدي من المحفظة" />
                    </div>
                </div>
            </div>
        </div>

        <!-- الملخص الحي -->
        <div class="card border-0 shadow-sm mb-4 summary-card" id="summaryCard">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-receipt me-2"></i>ملخص الحوالة</h6>
                <div class="row text-center g-3">
                    <div class="col-6">
                        <div class="text-muted small">رصيد <span id="sumFromName" class="fw-semibold">—</span> بعد الحوالة</div>
                        <div class="fs-5 fw-bold" id="sumFromAfter">—</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">رصيد <span id="sumToName" class="fw-semibold">—</span> بعد الحوالة</div>
                        <div class="fs-5 fw-bold text-success" id="sumToAfter">—</div>
                    </div>
                </div>
                <hr />
                <div id="statusMsg" class="text-center fw-semibold text-muted">
                    <i class="bi bi-info-circle me-1"></i> اختر الصندوقين وأدخل المبلغ
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" id="submitBtn" class="btn btn-success btn-lg flex-grow-1" disabled>
                <i class="bi bi-send-check-fill me-1"></i> تنفيذ الحوالة
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">إلغاء</a>
        </div>
    </form>
</div>

@functions {
    (string Icon, string ColorClass) GetBoxStyle(string name) => name switch
    {
        "شام كاش" => ("bi-bank2", "bg-primary-subtle text-primary"),
        "سيرياتيل كاش" => ("bi-phone-fill", "bg-danger-subtle text-danger"),
        "النقدي للمنزل" => ("bi-house-heart-fill", "bg-warning-subtle text-warning"),
        "تسوية الديون" => ("bi-clipboard2-check-fill", "bg-info-subtle text-info"),
        _ => ("bi-wallet-fill", "bg-success-subtle text-success")
    };
}

<style>
    .step-card { border-radius: 16px; }
    .step-badge {
        display: inline-flex; align-items: center; justify-content: center;
        width: 26px; height: 26px; border-radius: 50%;
        background: #146c43; color: #fff; font-size: .8rem; margin-left: .4rem;
    }
    .option-icon {
        width: 48px; height: 48px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
    }
    .box-option {
        border: 2px solid #e9ecef; border-radius: 14px; cursor: pointer;
        transition: .15s ease;
    }
    .box-option:hover { border-color: #146c43; transform: translateY(-2px); }
    .btn-check:checked + .box-option {
        border-color: #146c43; background: #e7f5ec;
        box-shadow: 0 6px 16px rgba(20,108,67,.18);
    }
    .btn-check:disabled + .box-option {
        opacity: .4; cursor: not-allowed; transform: none; border-style: dashed;
    }
    .swap-btn { width: 46px; height: 46px; transition: transform .35s ease; }
    .swap-btn.spin { transform: rotate(180deg); }
    .summary-card { border-radius: 16px; background: #f8f9fa; }
    #statusMsg.ok { color: #146c43 !important; }
    #statusMsg.err { color: #dc3545 !important; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const fromRadios = document.querySelectorAll('input[name="FromBoxId"]');
            const toRadios = document.querySelectorAll('input[name="ToBoxId"]');
            const amountInput = document.querySelector('input[name="Amount"]');
            const submitBtn = document.getElementById('submitBtn');
            const statusMsg = document.getElementById('statusMsg');
            const swapBtn = document.getElementById('swapBtn');
            const toHint = document.getElementById('toHint');

            const fmt = n => Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const selected = radios => Array.from(radios).find(r => r.checked);
            const meta = r => r ? {
                id: r.value, name: r.dataset.name,
                balance: parseFloat(r.dataset.balance), currency: r.dataset.currency
            } : null;

            function setStatus(text, icon, cls) {
                statusMsg.className = 'text-center fw-semibold ' + cls;
                statusMsg.innerHTML = '<i class="bi ' + icon + ' me-1"></i> ' + text;
            }

            function refresh() {
                const from = meta(selected(fromRadios));

                // تعطيل الخيارات غير المتوافقة في قائمة "المحوَّل إليه"
                toRadios.forEach(r => {
                    const incompatible = from && (r.value === from.id || r.dataset.currency !== from.currency);
                    r.disabled = !!incompatible;
                    if (incompatible && r.checked) r.checked = false;
                });

                toHint.textContent = from
                    ? 'الصناديق المتاحة هي التي تحمل عملة ' + from.currency + ' فقط.'
                    : 'اختر أولًا الصندوق المحوَّل منه، وستظهر لك الصناديق المتوافقة معه فقط.';

                const to = meta(selected(toRadios));
                const amount = parseFloat(amountInput.value) || 0;

                document.getElementById('currencyLabel').textContent = from ? from.currency : '—';
                document.getElementById('sumFromName').textContent = from ? from.name : '—';
                document.getElementById('sumToName').textContent = to ? to.name : '—';

                const fromAfter = document.getElementById('sumFromAfter');
                const toAfter = document.getElementById('sumToAfter');
                fromAfter.textContent = from ? fmt(from.balance - amount) : '—';
                toAfter.textContent = to ? fmt(to.balance + amount) : '—';
                fromAfter.classList.toggle('text-danger', !!from && (from.balance - amount) < 0);

                let valid = false;
                if (!from) setStatus('اختر الصندوق المحوَّل منه', 'bi-info-circle', 'text-muted');
                else if (!to) setStatus('اختر الصندوق المحوَّل إليه', 'bi-info-circle', 'text-muted');
                else if (amount <= 0) setStatus('أدخل مبلغًا أكبر من صفر', 'bi-info-circle', 'text-muted');
                else if (amount > from.balance) setStatus('المبلغ يتجاوز الرصيد المتاح (' + fmt(from.balance) + ' ' + from.currency + ')', 'bi-x-circle-fill', 'err');
                else { setStatus('الحوالة جاهزة للتنفيذ', 'bi-check-circle-fill', 'ok'); valid = true; }

                submitBtn.disabled = !valid;
            }

            fromRadios.forEach(r => r.addEventListener('change', refresh));
            toRadios.forEach(r => r.addEventListener('change', refresh));
            amountInput.addEventListener('input', refresh);

            // أزرار النسب السريعة
            document.querySelectorAll('.quick-pct').forEach(btn => {
                btn.addEventListener('click', function () {
                    const from = meta(selected(fromRadios));
                    if (!from) { setStatus('اختر الصندوق المحوَّل منه أولًا', 'bi-info-circle', 'err'); return; }
                    const pct = parseFloat(this.dataset.pct);
                    amountInput.value = (Math.floor(from.balance * pct) / 100).toFixed(2);
                    refresh();
                });
            });

            // عكس الاتجاه
            swapBtn.addEventListener('click', function () {
                const f = selected(fromRadios), t = selected(toRadios);
                if (!f || !t) { setStatus('اختر الصندوقين أولًا ليتم العكس', 'bi-info-circle', 'err'); return; }

                const newFrom = document.getElementById('from_' + t.value);
                if (newFrom.disabled) { setStatus('لا يمكن العكس لأن الصندوق الآخر بلا رصيد', 'bi-x-circle-fill', 'err'); return; }

                swapBtn.classList.toggle('spin');
                newFrom.checked = true;
                refresh();
                const newTo = document.getElementById('to_' + f.value);
                if (newTo && !newTo.disabled) newTo.checked = true;
                refresh();
            });

            refresh();
        });
    </script>
}