@model List<FinancialBox.Models.Transfer>
@{ ViewData["Title"] = "سجل الحوالات"; }

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-success mb-1"><i class="bi bi-clock-history me-2"></i>سجل الحوالات</h3>
            <p class="text-muted mb-0">جميع الحوالات التي أجريتها بين صناديقك</p>
        </div>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg me-1"></i> حوالة جديدة
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-arrow-left-right display-4 text-muted"></i>
            <h5 class="mt-3">لا توجد حوالات مسجلة بعد</h5>
            <p class="text-muted">ابدأ بنقل الأموال بين صناديقك</p>
            <a asp-action="Create" class="btn btn-success">إجراء حوالة</a>
        </div>
    }
    else
    {
        <!-- بطاقات إحصائية -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm stat-card">
                    <div class="card-body">
                        <div class="text-muted small">عدد الحوالات</div>
                        <div class="fs-3 fw-bold text-success">@Model.Count</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm stat-card">
                    <div class="card-body">
                        <div class="text-muted small">آخر حوالة</div>
                        <div class="fs-5 fw-bold">@Model.First().Date.ToString("yyyy-MM-dd")</div>
                    </div>
                </div>
            </div>
            @foreach (var g in Model.GroupBy(t => t.FromBox.Currency))
            {
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm stat-card">
                        <div class="card-body">
                            <div class="text-muted small">إجمالي المحوَّل (@g.Key)</div>
                            <div class="fs-5 fw-bold">@g.Sum(x => x.Amount).ToString("N2")</div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- البحث -->
        <div class="input-group mb-3" style="max-width: 420px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" id="searchInput" class="form-control" placeholder="ابحث بالصندوق أو الوصف أو التاريخ..." />
        </div>

        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="transfersTable">
                    <thead class="table-light">
                        <tr>
                            <th>التاريخ</th>
                            <th>الحوالة</th>
                            <th>المبلغ</th>
                            <th>الوصف</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td class="text-nowrap">@t.Date.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="text-muted small">من</span>
                                    <span class="badge bg-danger-subtle text-danger fw-semibold">@t.FromBox.Name</span>
                                    <span class="text-muted small ms-1">إلى</span>
                                    <span class="badge bg-success-subtle text-success fw-semibold">@t.ToBox.Name</span>
                                </td>
                                <td class="fw-bold text-nowrap">
                                    @t.Amount.ToString("N2") <small class="text-muted">@t.FromBox.Currency</small>
                                </td>
                                <td class="text-muted">@(string.IsNullOrWhiteSpace(t.Description) ? "—" : t.Description)</td>
                            </tr>
                        }
                        <tr id="noResultsRow" class="d-none">
                            <td colspan="4" class="text-center text-muted py-4">لا توجد نتائج مطابقة للبحث</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .stat-card { border-radius: 14px; transition: .15s ease; }
    .stat-card:hover { transform: translateY(-2px); }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const input = document.getElementById('searchInput');
            if (!input) return;

            const rows = document.querySelectorAll('#transfersTable tbody tr:not(#noResultsRow)');
            const noResults = document.getElementById('noResultsRow');

            input.addEventListener('input', function () {
                const q = this.value.trim().toLowerCase();
                let visible = 0;
                rows.forEach(row => {
                    const match = row.textContent.toLowerCase().includes(q);
                    row.classList.toggle('d-none', !match);
                    if (match) visible++;
                });
                noResults.classList.toggle('d-none', visible !== 0);
            });
        });
    </script>
}