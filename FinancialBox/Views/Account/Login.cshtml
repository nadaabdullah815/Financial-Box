@model FinancialBox.ViewModels.LoginViewModel
@{ ViewData["Title"] = "تسجيل الدخول"; }

<div class="auth-wrapper">
    <div class="auth-card">
        <h3 class="text-center mb-4"> تسجيل الدخول</h3>
        <form asp-action="Login" method="post" autocomplete="off">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label" >البريد الإلكتروني</label>
                <input asp-for="Email" class="form-control" autocomplete="off" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">كلمة السر</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

           
             

            <button type="submit" class="btn btn-primary w-100">دخول</button>
        </form>
        <p class="text-center mt-3 mb-0">ما عندك حساب؟ <a asp-action="Register">أنشئ حساب</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}