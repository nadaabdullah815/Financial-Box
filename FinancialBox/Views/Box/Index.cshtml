@model List<FinancialBox.Models.Box>
@{ ViewData["Title"] = "الصناديق المالية"; }

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-success mb-1"><i class="bi bi-wallet2 me-2"></i>الصناديق المالية</h3>
            <p class="text-muted mb-0">إدارة أموالك عبر الصناديق المختلفة</p>
        </div>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg me-1"></i> صندوق جديد
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-4 text-muted"></i>
            <h5 class="mt-3">لا يوجد لديك أي صندوق مالي بعد</h5>
            <p class="text-muted">ابدأ بإضافة أول صندوق لتتبع أموالك</p>
            <a asp-action="Create" class="btn btn-success">إنشاء صندوق</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var box in Model)
            {
                var (icon, colorClass) = GetBoxStyle(box.Name);
                <div class="col-md-4 col-lg-3">
                    <div class="card box-card h-100 border-0 shadow-sm position-relative">
                        @if (box.IsDefault)
                        {
                            <span class="badge bg-secondary position-absolute top-0 end-0 m-2">
                                <i class="bi bi-shield-check me-1"></i>أساسي
                            </span>
                        }
                        <div class="card-body">
                            <div class="icon-circle-lg @colorClass mb-3">
                                <i class="bi @icon fs-3"></i>
                            </div>
                            <span class="badge bg-light text-dark border mb-2">@box.Currency</span>
                            <h5 class="fw-bold mb-1">@box.Name</h5>
                            <div class="fs-4 fw-bold text-success mb-2">@box.Balance.ToString("N2")</div>

                            @if (box.TargetAmount.HasValue && box.TargetAmount > 0)
                            {
                                var progress = Math.Min(100, (double)(box.Balance / box.TargetAmount.Value) * 100);
                                <div class="mb-2">
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar bg-success" style="width:@progress.ToString("0")%"></div>
                                    </div>
                                    <small class="text-muted">@progress.ToString("0")% من الهدف (@box.TargetAmount.Value.ToString("N0"))</small>
                                </div>
                            }

                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <a asp-controller="Transaction" asp-action="Index" asp-route-boxId="@box.Id" class="btn btn-success btn-sm">
                                    <i class="bi bi-list-ul me-1"></i> العمليات
                                </a>
                                <a asp-action="Edit" asp-route-id="@box.Id" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (!box.IsDefault)
                                {
                                    <a asp-action="Delete" asp-route-id="@box.Id" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@functions {
    (string Icon, string ColorClass) GetBoxStyle(string name) => name switch
    {
        "شام كاش" => ("bi-bank2", "bg-primary-subtle text-primary"),
        "سيرياتيل كاش" => ("bi-phone-fill", "bg-danger-subtle text-danger"),
        "النقدي للمنزل" => ("bi-house-heart-fill", "bg-warning-subtle text-warning"),
        "تسوية الديون" => ("bi-clipboard2-check-fill", "bg-info-subtle text-info"),
        _ => ("bi-wallet-fill", "bg-success-subtle text-success")
    };
}

<style>
    .icon-circle-lg {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .box-card {
        border-radius: 16px;
        transition: 0.2s ease;
    }

    .box-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 24px rgba(0,0,0,0.1) !important;
    }
</style>