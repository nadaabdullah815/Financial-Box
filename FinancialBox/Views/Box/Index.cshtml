@model List<FinancialBox.Models.Box>
@{ ViewData["Title"] = "الصناديق المالية"; }

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-success mb-1"><i class="bi bi-wallet2 me-2"></i>الصناديق المالية</h3>
            <p class="text-muted mb-0">إدارة أموالك عبر الصناديق المختلفة</p>
        </div>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg me-1"></i> صندوق جديد
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-4 text-muted"></i>
            <h5 class="mt-3">لا يوجد لديك أي صندوق مالي بعد</h5>
            <p class="text-muted">ابدأ بإضافة أول صندوق لتتبع أموالك</p>
            <a asp-action="Create" class="btn btn-success">إنشاء صندوق</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var box in Model)
            {
                var (icon, colorClass) = GetBoxStyle(box.Name);
                <div class="col-md-4 col-lg-3">
                   <div class="card box-card h-100 border-0 shadow-sm position-relative">
                        <div class="box-banner @colorClass"><i class="bi @icon"></i></div>
                        @if (box.IsDefault) { <span class="badge bg-secondary position-absolute top-0 end-0 m-2">أساسي</span> }
                        <div class="card-body">
                            <span class="badge bg-light text-dark border mb-2">@box.Currency</span>
                            <h5 class="fw-bold mb-1">@box.Name</h5>
                            <div class="fs-4 fw-bold text-success mb-2">@box.Balance.ToString("N2")</div>

                            @if (box.IsDebtBox)
                            {
                                <div class="alert alert-info py-1 px-2 mb-2 small">
                                    <i class="bi bi-info-circle-fill me-1"></i> صندوق خاص، مستبعد من حسابات التقارير العامة
                                </div>
                            }
                            @if (box.TargetAmount.HasValue && box.TargetAmount > 0)
                            {
                                var progress = Math.Min(100, (double)(box.Balance / box.TargetAmount.Value) * 100);
                                <div class="mb-2">
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar bg-success" style="width:@progress.ToString("0")%"></div>
                                    </div>
                                    <small class="text-muted">@progress.ToString("0")% من الهدف (@box.TargetAmount.Value.ToString("N0"))</small>
                                </div>
                            }

                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <a asp-controller="Transaction" asp-action="Index" asp-route-boxId="@box.Id" class="btn btn-success btn-sm">
                                    <i class="bi bi-list-ul me-1"></i> العمليات
                                </a>
                                <a asp-action="Edit" asp-route-id="@box.Id" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (!box.IsDefault)
                                {
                                    <a asp-action="Delete" asp-route-id="@box.Id" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@functions {
    (string Icon, string GradientClass) GetBoxStyle(string name) => name switch
    {
        "شام كاش" => ("bi-bank2", "grad-shamcash"),
        "سيرياتيل كاش" => ("bi-phone-fill", "grad-syriatel"),
        "النقدي للمنزل" => ("bi-house-heart-fill", "grad-home"),
        "تسوية الديون" => ("bi-clipboard2-check-fill", "grad-debt"),
        _ => ("bi-wallet-fill", "grad-custom")
    };
}
<style>
    .icon-circle-lg {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .box-card {
        border-radius: 16px;
        transition: 0.2s ease;
    }

    .box-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 24px rgba(0,0,0,0.1) !important;
    }
    .box-banner {
    height: 70px; border-radius: 14px 14px 0 0; position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    }
    .box-banner i { font-size: 2.2rem; color: rgba(255,255,255,.9); }
    .box-banner::after {
        content: ""; position: absolute; inset: 0; background: rgba(255,255,255,.08);
    }
    .grad-shamcash { background: linear-gradient(135deg, #0d6efd, #0a4fb0); }
    .grad-syriatel { background: linear-gradient(135deg, #e4002b, #a10021); }
    .grad-home     { background: linear-gradient(135deg, #ffb703, #e08e00); }
    .grad-debt     { background: linear-gradient(135deg, #17a2b8, #0f7080); }
    .grad-custom   { background: linear-gradient(135deg, #146c43, #0f5132); }
</style>