@model FinancialBox.Models.Box
@{ ViewData["Title"] = "حذف الصندوق"; }

<div class="container py-5 d-flex justify-content-center">
    <div class="card border-0 shadow-sm delete-card" style="max-width: 520px; width: 100%;">
        <div class="card-body p-4 p-md-5">

            <div class="text-center mb-4">
                <div class="icon-circle-lg bg-danger-subtle text-danger mx-auto mb-3">
                    <i class="bi bi-exclamation-triangle-fill fs-2"></i>
                </div>
                <h4 class="fw-bold text-danger mb-1">تأكيد حذف الصندوق</h4>
                <p class="text-muted small mb-0">هذا الإجراء نهائي ولا يمكن التراجع عنه</p>
            </div>

            <!-- بطاقة الصندوق -->
            <div class="box-summary d-flex align-items-center justify-content-between mb-4">
                <div>
                    <span class="badge bg-light text-dark border mb-1">@Model.Currency</span>
                    <h5 class="fw-bold mb-0">@Model.Name</h5>
                </div>
                <div class="text-end">
                    <div class="text-muted small">الرصيد الحالي</div>
                    <div class="fs-5 fw-bold text-success">@Model.Balance.ToString("N2")</div>
                </div>
            </div>

            <!-- ما الذي سيحدث -->
            <div class="alert alert-danger py-3 small mb-4" role="alert">
                <div class="fw-bold mb-2"><i class="bi bi-info-circle-fill me-1"></i> عند الحذف:</div>
                <ul class="mb-0 ps-3">
                    <li>سيتم حذف الصندوق نهائيًا مع رصيده.</li>
                    <li>سيتم حذف جميع العمليات المالية (الإيرادات والمصاريف) المرتبطة به.</li>
                    <li>لا يمكن حذف صندوق مرتبط بحوالات سابقة.</li>
                </ul>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />

                <!-- تأكيد بكتابة الاسم -->
                <div class="mb-4">
                    <label for="confirmName" class="form-label fw-semibold">
                        للتأكيد، اكتب اسم الصندوق: <span class="text-danger">@Model.Name</span>
                    </label>
                    <input type="text" id="confirmName" class="form-control form-control-lg"
                           data-name="@Model.Name" autocomplete="off" placeholder="اكتب الاسم هنا" />
                    <div class="form-text" id="confirmHint">لن يتفعل زر الحذف إلا بعد كتابة الاسم بشكل صحيح.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" id="deleteBtn" class="btn btn-danger btn-lg flex-grow-1" disabled>
                        <i class="bi bi-trash-fill me-1"></i> نعم، احذف الصندوق
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">إلغاء</a>
                </div>
            </form>

        </div>
    </div>
</div>

<style>
    .delete-card { border-radius: 18px; border-top: 5px solid #dc3545 !important; }
    .icon-circle-lg {
        width: 80px; height: 80px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
    }
    .box-summary {
        background: #f8f9fa; border: 1px solid #e9ecef;
        border-radius: 14px; padding: 1rem 1.25rem;
    }
    #confirmName.is-match { border-color: #146c43; box-shadow: 0 0 0 .2rem rgba(20,108,67,.15); }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const input = document.getElementById('confirmName');
            const btn = document.getElementById('deleteBtn');
            const hint = document.getElementById('confirmHint');
            const expected = input.dataset.name.trim();

            input.addEventListener('input', function () {
                const match = this.value.trim() === expected;
                btn.disabled = !match;
                this.classList.toggle('is-match', match);
                hint.textContent = match
                    ? 'تم التأكيد، يمكنك الآن حذف الصندوق.'
                    : 'لن يتفعل زر الحذف إلا بعد كتابة الاسم بشكل صحيح.';
                hint.classList.toggle('text-success', match);
            });
        });
    </script>
}