@model FinancialBox.ViewModels.TransactionViewModel
@using System.Globalization
@{
    ViewData["Title"] = "تسجيل عملية مالية";
    var boxes = Model.UserBoxes ?? new List<FinancialBox.Models.Box>();
    var categories = Model.Categories ?? new List<FinancialBox.Models.Category>();
    var isIncome = Model.Type == "Income";
    var lockedBox = boxes.FirstOrDefault(b => b.Id == Model.BoxId);
}

<div class="container py-4" style="max-width: 1000px;">
    <div id="txWrapper" class="@(isIncome ? "theme-income" : "theme-expense")">

        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h3 class="fw-bold mb-1 accent-text"><i class="bi bi-journal-plus me-2"></i><span id="pageTitle">تسجيل مصروف جديد</span></h3>
                <p class="text-muted mb-0">سجّل العملية وسيتم تحديث رصيد الصندوق تلقائيًا</p>
            </div>
            <a asp-controller="Box" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> العودة إلى الصناديق
            </a>
        </div>

        <form asp-action="Create" method="post" id="txForm">
            <div class="row g-4">

                <div class="col-lg-8">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="btn-group w-100 mb-4 type-switch" role="group">
                        <input type="radio" class="btn-check" name="Type" id="typeExpense" value="Expense" checked="@(!isIncome)" />
                        <label class="btn type-btn expense py-3" for="typeExpense">
                            <i class="bi bi-graph-down-arrow me-1"></i> مصروف
                        </label>

                        <input type="radio" class="btn-check" name="Type" id="typeIncome" value="Income" checked="@isIncome" />
                        <label class="btn type-btn income py-3" for="typeIncome">
                            <i class="bi bi-graph-up-arrow me-1"></i> إيراد
                        </label>
                    </div>

                    <div class="card border-0 shadow-sm section-card mb-3">
                        <div class="card-body p-4">
                            <label asp-for="Amount" class="form-label fw-semibold">المبلغ</label>
                            <div class="input-group input-group-lg mb-2">
                                <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control amount-input"
                                       placeholder="0.00"
                                       value="@(Model.Amount > 0 ? Model.Amount.ToString(CultureInfo.InvariantCulture) : "")" />
                                <span class="input-group-text fw-bold" id="currencyLabel">—</span>
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                            <div class="d-flex flex-wrap gap-2 mt-2" id="quickAmounts"></div>
                        </div>
                    </div>

                    <!-- الصندوق -->
                    <div class="card border-0 shadow-sm section-card mb-3">
                        <div class="card-body p-4">
                            <h6 class="fw-bold mb-3"><i class="bi bi-wallet2 me-2"></i>الصندوق</h6>

                            @if (lockedBox != null)
                            {
                                var (lockedIcon, lockedColor) = GetBoxStyle(lockedBox.Name);
                                <input type="hidden" name="BoxId" value="@lockedBox.Id"
                                       data-balance="@lockedBox.Balance.ToString(CultureInfo.InvariantCulture)"
                                       data-currency="@lockedBox.Currency" data-name="@lockedBox.Name" id="lockedBoxInput" />

                                <div class="pick-tile card p-3 locked-box d-flex flex-row align-items-center gap-3" style="max-width: 320px;">
                                    <div class="mini-icon @lockedColor"><i class="bi @lockedIcon fs-5"></i></div>
                                    <div>
                                        <div class="fw-bold">@lockedBox.Name</div>
                                        <div class="text-success fw-bold small">@lockedBox.Balance.ToString("N2") @lockedBox.Currency</div>
                                    </div>
                                    <i class="bi bi-lock-fill text-muted ms-auto"></i>
                                </div>
                                <small class="text-muted d-block mt-2">العملية ستُسجَّل على هذا الصندوق تحديدًا، ولا يمكن تغييره من هذه الصفحة.</small>
                            }
                            else
                            {
                                <div class="row g-3">
                                    @foreach (var box in boxes)
                                    {
                                        var (icon, color) = GetBoxStyle(box.Name);
                                        <div class="col-6 col-md-4">
                                            <input type="radio" class="btn-check" name="BoxId" id="box_@box.Id" value="@box.Id"
                                                   data-balance="@box.Balance.ToString(CultureInfo.InvariantCulture)"
                                                   data-currency="@box.Currency" data-name="@box.Name"
                                                   checked="@(Model.BoxId == box.Id)" />
                                            <label class="pick-tile card h-100 text-center p-3" for="box_@box.Id">
                                                <div class="mini-icon @color mx-auto mb-2"><i class="bi @icon fs-5"></i></div>
                                                <div class="fw-bold small">@box.Name</div>
                                                <div class="text-success fw-bold small">@box.Balance.ToString("N2")</div>
                                                <span class="badge bg-light text-dark border mt-1">@box.Currency</span>
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                            <span asp-validation-for="BoxId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- التصنيف -->
                    <div class="card border-0 shadow-sm section-card mb-3">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold mb-0"><i class="bi bi-tags me-2"></i>التصنيف</h6>
                                <a asp-controller="Category" asp-action="Create" asp-route-returnBoxId="@Model.BoxId"
                                   class="small text-decoration-none accent-text">
                                    <i class="bi bi-plus-circle me-1"></i> تصنيف جديد
                                </a>
                            </div>
                            <div class="row g-2" id="categoryGrid">
                                @foreach (var cat in categories)
                                {
                                    <div class="col-4 col-md-3 cat-col" data-type="@cat.Type.ToString()">
                                        <input type="radio" class="btn-check" name="CategoryId" id="cat_@cat.Id" value="@cat.Id"
                                               data-name="@cat.Name" checked="@(Model.CategoryId == cat.Id)" />
                                        <label class="pick-tile card h-100 text-center p-2" for="cat_@cat.Id">
                                            <div class="mini-icon cat-icon mx-auto mb-1"><i class="bi @GetCategoryIcon(cat.Name)"></i></div>
                                            <span class="small fw-semibold">@cat.Name</span>
                                        </label>
                                    </div>
                                }
                            </div>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm section-card mb-3">
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-md-5">
                                    <label asp-for="Date" class="form-label fw-semibold">التاريخ</label>
                                    <input asp-for="Date" type="date" class="form-control"
                                           value="@Model.Date.ToString("yyyy-MM-dd")" />
                                    <div class="d-flex gap-2 mt-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="dateToday">اليوم</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="dateYesterday">أمس</button>
                                    </div>
                                    <span asp-validation-for="Date" class="text-danger small"></span>
                                </div>
                                <div class="col-md-7">
                                    <label asp-for="Description" class="form-label fw-semibold">
                                        البيان <span class="text-muted fw-normal">(اختياري)</span>
                                    </label>
                                    <textarea asp-for="Description" class="form-control" rows="3" maxlength="200"
                                              placeholder="مثال: فاتورة كهرباء شهر 9"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="summary-sticky">
                        <div class="card border-0 shadow-sm summary-card">
                            <div class="card-body p-4">
                                <h6 class="fw-bold mb-3"><i class="bi bi-receipt me-2"></i>ملخص العملية</h6>

                                <div class="net-box text-center mb-3">
                                    <div class="small text-muted" id="netLabel">صافي المبلغ المخصوم</div>
                                    <div class="fs-2 fw-bold accent-text" id="sumAmount">0.00</div>
                                    <div class="small text-muted" id="sumCurrency">—</div>
                                </div>

                                <ul class="list-unstyled small mb-3">
                                    <li class="d-flex justify-content-between py-1 border-bottom">
                                        <span class="text-muted">الصندوق</span><span class="fw-semibold" id="sumBox">—</span>
                                    </li>
                                    <li class="d-flex justify-content-between py-1 border-bottom">
                                        <span class="text-muted">التصنيف</span><span class="fw-semibold" id="sumCategory">—</span>
                                    </li>
                                    <li class="d-flex justify-content-between py-1">
                                        <span class="text-muted">الرصيد بعد العملية</span><span class="fw-bold" id="sumAfter">—</span>
                                    </li>
                                </ul>

                                <div id="statusMsg" class="text-center fw-semibold small text-muted mb-3">
                                    <i class="bi bi-info-circle me-1"></i> أكمل بيانات العملية
                                </div>

                                <button type="submit" id="submitBtn" class="btn btn-accent btn-lg w-100" disabled>
                                    <i class="bi bi-check-circle-fill me-1"></i> <span id="submitLabel">حفظ المصروف</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

@functions {
    (string Icon, string ColorClass) GetBoxStyle(string name) => name switch
    {
        "شام كاش" => ("bi-bank2", "bg-primary-subtle text-primary"),
        "سيرياتيل كاش" => ("bi-phone-fill", "bg-danger-subtle text-danger"),
        "النقدي للمنزل" => ("bi-house-heart-fill", "bg-warning-subtle text-warning"),
        "تسوية الديون" => ("bi-clipboard2-check-fill", "bg-info-subtle text-info"),
        _ => ("bi-wallet-fill", "bg-success-subtle text-success")
    };

    string GetCategoryIcon(string name) => name switch
    {
        "راتب" => "bi-briefcase-fill",
        "عمل حر" => "bi-laptop-fill",
        "استثمار" => "bi-graph-up",
        "إضافي" => "bi-plus-circle-fill",
        "طعام" => "bi-cup-hot-fill",
        "أدوات منزلية" => "bi-house-heart-fill",
        "فاتورة" => "bi-receipt",
        "مواصلات" => "bi-car-front-fill",
        _ => "bi-tag-fill"
    };
}

<style>
    .theme-income  { --accent: #146c43; --accent-soft: #e7f5ec; }
    .theme-expense { --accent: #dc3545; --accent-soft: #fdecee; }

    .accent-text { color: var(--accent) !important; }
    .section-card, .summary-card { border-radius: 16px; }
    .summary-card { background: #fbfbfc; border-top: 5px solid var(--accent) !important; }
    .net-box { background: var(--accent-soft); border-radius: 14px; padding: 1rem; }

    .type-switch .type-btn {
        border: 2px solid #e9ecef; background: #fff; font-weight: 700; color: #6c757d;
        transition: .15s ease;
    }
    .type-switch .btn-check:checked + .type-btn.expense { background: #dc3545; border-color: #dc3545; color: #fff; }
    .type-switch .btn-check:checked + .type-btn.income  { background: #146c43; border-color: #146c43; color: #fff; }

    .amount-input { font-size: 1.6rem; font-weight: 700; }

    .pick-tile {
        border: 2px solid #e9ecef; border-radius: 14px; cursor: pointer; transition: .15s ease;
    }
    .pick-tile:hover { border-color: var(--accent); transform: translateY(-2px); }
    .btn-check:checked + .pick-tile {
        border-color: var(--accent); background: var(--accent-soft);
        box-shadow: 0 6px 16px rgba(0,0,0,.08);
    }
    .locked-box {
        border-color: var(--accent) !important;
        background: var(--accent-soft);
        cursor: default;
    }
    .mini-icon {
        width: 42px; height: 42px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
    }
    .cat-icon { background: var(--accent-soft); color: var(--accent); }

    .btn-accent { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 700; }
    .btn-accent:hover:not(:disabled) { filter: brightness(.92); color: #fff; }
    .btn-accent:disabled { background: #adb5bd; border-color: #adb5bd; color: #fff; }

    #statusMsg.ok  { color: #146c43 !important; }
    #statusMsg.err { color: #dc3545 !important; }

    @@media (min-width: 992px) {
        .summary-sticky { position: sticky; top: 90px; }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const wrapper = document.getElementById('txWrapper');
            const typeRadios = document.querySelectorAll('input[name="Type"]');
            const boxRadios = document.querySelectorAll('input[name="BoxId"]');
            const lockedInput = document.getElementById('lockedBoxInput');
            const catRadios = document.querySelectorAll('input[name="CategoryId"]');
            const catCols = document.querySelectorAll('.cat-col');
            const amountInput = document.getElementById('Amount');
            const dateInput = document.getElementById('Date');
            const quickBox = document.getElementById('quickAmounts');
            const submitBtn = document.getElementById('submitBtn');
            const statusMsg = document.getElementById('statusMsg');

            const quickSets = {
                SYP: [10000, 25000, 50000, 100000, 250000],
                USD: [5, 10, 25, 50, 100]
            };

            const fmt = n => Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const selected = radios => Array.from(radios).find(r => r.checked);
            const currentType = () => (selected(typeRadios) || {}).value || 'Expense';
            const toISO = d => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);

            let lastCurrency = null;

            function renderQuickAmounts(currency) {
                quickBox.innerHTML = '';
                (quickSets[currency] || []).forEach(v => {
                    const b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'btn btn-sm btn-outline-secondary';
                    b.textContent = '+' + v.toLocaleString('en-US');
                    b.addEventListener('click', () => {
                        amountInput.value = ((parseFloat(amountInput.value) || 0) + v).toFixed(2);
                        refresh();
                    });
                    quickBox.appendChild(b);
                });
                const clear = document.createElement('button');
                clear.type = 'button';
                clear.className = 'btn btn-sm btn-outline-danger';
                clear.textContent = 'تصفير';
                clear.addEventListener('click', () => { amountInput.value = ''; refresh(); });
                quickBox.appendChild(clear);
            }

            function setStatus(text, icon, cls) {
                statusMsg.className = 'text-center fw-semibold small mb-3 ' + cls;
                statusMsg.innerHTML = '<i class="bi ' + icon + ' me-1"></i> ' + text;
            }

            function refresh() {
                const type = currentType();
                const isIncome = type === 'Income';

                wrapper.classList.toggle('theme-income', isIncome);
                wrapper.classList.toggle('theme-expense', !isIncome);
                document.getElementById('pageTitle').textContent = isIncome ? 'تسجيل إيراد جديد' : 'تسجيل مصروف جديد';
                document.getElementById('netLabel').textContent = isIncome ? 'صافي المبلغ المضاف' : 'صافي المبلغ المخصوم';
                document.getElementById('submitLabel').textContent = isIncome ? 'حفظ الإيراد' : 'حفظ المصروف';

                catCols.forEach(col => {
                    const match = col.dataset.type === type;
                    col.classList.toggle('d-none', !match);
                    const input = col.querySelector('input');
                    if (!match && input.checked) input.checked = false;
                });

                const boxRadio = lockedInput || selected(boxRadios);
                const catRadio = selected(catRadios);
                const box = boxRadio ? {
                    name: boxRadio.dataset.name,
                    balance: parseFloat(boxRadio.dataset.balance),
                    currency: boxRadio.dataset.currency
                } : null;
                const amount = parseFloat(amountInput.value) || 0;

                const currency = box ? box.currency : 'SYP';
                if (currency !== lastCurrency) { renderQuickAmounts(currency); lastCurrency = currency; }

                document.getElementById('currencyLabel').textContent = box ? box.currency : '—';
                document.getElementById('sumCurrency').textContent = box ? box.currency : '—';
                document.getElementById('sumAmount').textContent = fmt(amount);
                document.getElementById('sumBox').textContent = box ? box.name : '—';
                document.getElementById('sumCategory').textContent = catRadio ? catRadio.dataset.name : '—';

                const afterEl = document.getElementById('sumAfter');
                if (box) {
                    const after = isIncome ? box.balance + amount : box.balance - amount;
                    afterEl.textContent = fmt(after) + ' ' + box.currency;
                    afterEl.classList.toggle('text-danger', after < 0);
                } else {
                    afterEl.textContent = '—';
                }

                let valid = false;
                if (!box) setStatus('اختر الصندوق', 'bi-info-circle', 'text-muted');
                else if (!catRadio) setStatus('اختر التصنيف', 'bi-info-circle', 'text-muted');
                else if (amount <= 0) setStatus('أدخل مبلغًا أكبر من صفر', 'bi-info-circle', 'text-muted');
                else if (!isIncome && amount > box.balance) setStatus('الرصيد غير كافٍ (المتاح ' + fmt(box.balance) + ' ' + box.currency + ')', 'bi-x-circle-fill', 'err');
                else { setStatus('العملية جاهزة للحفظ', 'bi-check-circle-fill', 'ok'); valid = true; }

                submitBtn.disabled = !valid;
            }

            typeRadios.forEach(r => r.addEventListener('change', refresh));
            boxRadios.forEach(r => r.addEventListener('change', refresh));
            catRadios.forEach(r => r.addEventListener('change', refresh));
            amountInput.addEventListener('input', refresh);

            document.getElementById('dateToday').addEventListener('click', () => { dateInput.value = toISO(new Date()); });
            document.getElementById('dateYesterday').addEventListener('click', () => {
                const d = new Date(); d.setDate(d.getDate() - 1); dateInput.value = toISO(d);
            });

            refresh();
        });
    </script>
}