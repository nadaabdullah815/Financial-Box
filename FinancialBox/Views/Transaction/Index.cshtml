@model List<FinancialBox.Models.Transaction>
@{
    ViewData["Title"] = "العمليات المالية";
    var box = ViewBag.Box as FinancialBox.Models.Box;
    var totalIncome = Model.Where(t => t.Category.Type == FinancialBox.Models.Enum.CategoryType.Income).Sum(t => t.Amount);
    var totalExpense = Model.Where(t => t.Category.Type == FinancialBox.Models.Enum.CategoryType.Expense).Sum(t => t.Amount);
     var isDebt = box?.IsDebtBox == true;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-success mb-1"><i class="bi bi-list-ul me-2"></i>عمليات @(box?.Name ?? "الصندوق")</h3>
           <p class="text-muted mb-0">الرصيد الحالي: <span class="fw-bold text-success">@(box?.Balance.ToSmartString() ?? "0") @box?.Currency</span></p>
        </div>
        <a asp-action="Create" asp-route-boxId="@ViewBag.BoxId" class="btn btn-success">
            <i class="bi bi-plus-lg me-1"></i> عملية جديدة
        </a>
    </div>

    @if (box != null && box.IsDebtBox)
    {
        <div class="alert alert-info d-inline-block py-1 px-3 small mb-3">
            <i class="bi bi-info-circle-fill me-1"></i> صندوق الديون مستقل عن التقارير العامة — عملياته لا تُحتسب ضمن إجمالي الإيرادات والمصاريف
        </div>
    }
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm stat-card income-card">
                <div class="card-body d-flex align-items-center">
                    <div class="mini-icon bg-success-subtle text-success me-3"><i class="bi bi-graph-up-arrow"></i></div>
                    <div><div class="text-muted small">@(isDebt ? "إجمالي الديون الجديدة" : "إجمالي الإيرادات")</div><div class="fs-5 fw-bold text-success">@totalIncome.ToString("N2")</div></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm stat-card">
                <div class="card-body d-flex align-items-center">
                    <div class="mini-icon bg-danger-subtle text-danger me-3"><i class="bi bi-graph-down-arrow"></i></div>
                    <div><div class="text-muted small">@(isDebt ? "إجمالي الدفعات المسددة" : "إجمالي المصاريف")</div><div class="fs-5 fw-bold text-danger">@totalExpense.ToString("N2")</div></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm stat-card">
                <div class="card-body d-flex align-items-center">
                    <div class="mini-icon bg-primary-subtle text-primary me-3"><i class="bi bi-calculator"></i></div>
                  <div><div class="text-muted small">@(isDebt ? "صافي الدين لهذه الفترة" : "الصافي")</div><div class="fs-5 fw-bold">@((totalIncome - totalExpense).ToString("N2"))</div></div>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-4 text-muted"></i>
            <h5 class="mt-3">لا توجد عمليات مسجلة على هذا الصندوق بعد</h5>
            <a asp-action="Create" asp-route-boxId="@ViewBag.BoxId" class="btn btn-success mt-2">تسجيل أول عملية</a>
        </div>
    }
    else
    {
        <div class="input-group mb-3" style="max-width: 380px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" id="searchInput" class="form-control" placeholder="ابحث بالتصنيف أو البيان..." />
        </div>

        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="txTable">
                    <thead class="table-light">
                        <tr><th>التاريخ</th><th>النوع</th><th>التصنيف</th><th>البيان</th><th>المبلغ</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            var isIncome = t.Category.Type == FinancialBox.Models.Enum.CategoryType.Income;
                            <tr>
                                <td class="text-nowrap">@t.Date.ToString("yyyy-MM-dd")</td>
                               <td>
                                    @if (isIncome)
                                    { <span class="badge bg-success-subtle text-success"><i class="bi bi-arrow-down-circle-fill me-1"></i>@(isDebt ? "دين" : "إيراد")</span> }
                                    else
                                    { <span class="badge bg-danger-subtle text-danger"><i class="bi bi-arrow-up-circle-fill me-1"></i>@(isDebt ? "سداد" : "مصروف")</span> }
                                </td>
                                <td>@t.Category.Name</td>
                                <td class="text-muted">@(string.IsNullOrWhiteSpace(t.Description) ? "—" : t.Description)</td>
                                <td class="fw-bold @(isIncome ? "text-success" : "text-danger")">
                                    @(isIncome ? "+" : "-")@t.Amount.ToString("N2")
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-delete-tx"
                                            data-id="@t.Id" data-box="@ViewBag.BoxId" title="حذف">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        <tr id="noResultsRow" class="d-none"><td colspan="6" class="text-center text-muted py-4">لا توجد نتائج مطابقة</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    }

    <a asp-controller="Box" asp-action="Index" class="btn btn-outline-secondary mt-3">
        <i class="bi bi-arrow-right me-1"></i> العودة إلى الصناديق
    </a>
</div>

<!-- Modal تأكيد الحذف -->
<div class="modal fade" id="deleteTxModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>تأكيد الحذف</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">هل أنت متأكد من حذف هذه العملية؟ سيتم تعديل رصيد الصندوق تلقائيًا.</div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                <form id="deleteTxForm" asp-action="Delete" method="post">
                    <input type="hidden" name="id" id="deleteTxId" />
                    <input type="hidden" name="boxId" id="deleteTxBoxId" />
                    <button type="submit" class="btn btn-danger">نعم، احذف</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .stat-card { border-radius: 14px; }
    .mini-icon { width: 46px; height: 46px; border-radius: 12px; display: flex; align-items: center; justify-content: center; }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modal = new bootstrap.Modal(document.getElementById('deleteTxModal'));
            document.querySelectorAll('.btn-delete-tx').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.getElementById('deleteTxId').value = this.dataset.id;
                    document.getElementById('deleteTxBoxId').value = this.dataset.box;
                    modal.show();
                });
            });

            const input = document.getElementById('searchInput');
            if (input) {
                const rows = document.querySelectorAll('#txTable tbody tr:not(#noResultsRow)');
                const noResults = document.getElementById('noResultsRow');
                input.addEventListener('input', function () {
                    const q = this.value.trim().toLowerCase();
                    let visible = 0;
                    rows.forEach(row => {
                        const match = row.textContent.toLowerCase().includes(q);
                        row.classList.toggle('d-none', !match);
                        if (match) visible++;
                    });
                    noResults.classList.toggle('d-none', visible !== 0);
                });
            }
        });
    </script>
}